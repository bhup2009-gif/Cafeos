# Cloud mode for local testing. Vercel always requires cloud mode.
CAFEOS_STORAGE=cloud
# Server-only shared transaction pooler connection, port 6543.
DATABASE_URL=
# Official Supabase root certificate; paste full PEM value with line breaks.
SUPABASE_CA_CERT=
# Optional display/configuration values; not secrets.
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_SUPABASE_URL=
# Public Supabase Auth / Data API is not used by this first cloud release.
# No Supabase service-role key is required.
# Local-only SQLite development: set CAFEOS_STORAGE=local outside Vercel.
# CAFEOS_DATA_DIR=
# Never set CAFEOS_DEMO_PASSWORD for live data or commit .env.local.
