# Template only. Future cloud variables are NOT connected to the app yet.
# Copy to .env.local for development when cloud implementation is ready.
# Never put secrets in NEXT_PUBLIC_* variables or commit real values.

# Planned public app origin and Supabase project configuration
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Planned server-only credentials; use separate preview/production projects
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=
PLATFORM_RECOVERY_EMAIL=

# Current local SQLite directory (optional; default: ./data)
# CAFEOS_DATA_DIR=
# CAFEOS_DEMO_PASSWORD is local/test-only; never configure it in production.

# Admin passwords and the three access keys belong in secure provisioning,
# never in this template or public environment variables.
