{
  "name": "cafeos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3100",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/test-rea-e2e.mjs",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate-cloud.ts",
    "admin:provision": "node --env-file=.env.local --import tsx scripts/provision-platform-admin.ts",
    "test:cloud": "CAFEOS_CLOUD_TESTS=1 node --env-file=.env.local --import tsx --test tests/cloud.test.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "postgres": "^4.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "24.x"
  },
  "type": "module"
}
